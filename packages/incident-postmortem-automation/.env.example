# Copy to .env and fill in. Never commit the filled-in copy.

# Required for any draft to be generated. Get one at console.anthropic.com —
# this is your own key, billed to your own account.
ANTHROPIC_API_KEY=

# Required only for the webhook adapters (bin/postmortem.mjs works without
# these, off a plain timeline file).
PAGERDUTY_WEBHOOK_SECRET=
PAGERDUTY_API_TOKEN=

# Optional — without it, drafts print/log but are never posted anywhere.
SLACK_WEBHOOK_URL=

# Optional — only for adapters/pagerduty-webhook.mjs (the standalone server).
PORT=8787
