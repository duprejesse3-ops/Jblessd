#
# Run Gate as the same user, on the same machine, as Meridian Host — Gate
# is meant to sit between Host's container and the network, not on a
# separate box.
#
# Install:
#   sed -i "s|REPLACE_WITH_PACKAGE_PATH|$(pwd)|g" adapters/systemd.service
#   mkdir -p ~/.config/systemd/user
#   cp adapters/systemd.service ~/.config/systemd/user/meridian-gate.service
#   systemctl --user enable --now meridian-gate

[Unit]
Description=Meridian Gate
After=network.target

[Service]
Type=simple
WorkingDirectory=REPLACE_WITH_PACKAGE_PATH
ExecStart=/usr/bin/env node REPLACE_WITH_PACKAGE_PATH/bin/gate.mjs start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
