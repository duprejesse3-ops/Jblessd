# Settings for the container. Copy to container/.env and fill in.
# Never commit the filled-in copy — .gitignore already excludes .env.

# --- Required ---------------------------------------------------------------

# Password for the bundled Postgres. Any strong random string; compose builds
# DATABASE_URL from it automatically.
POSTGRES_PASSWORD=

# The public URL visitors reach. Used for canonical URLs, sitemap entries,
# Stripe redirect targets, and — importantly — as the origin the scheduled
# crawler and IndexNow jobs audit. Leaving this as localhost makes those jobs
# crawl the container instead of the real site.
SITE_URL=https://example.com

# --- Payments ---------------------------------------------------------------

STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint pointing at SITE_URL/api/webhook.
STRIPE_WEBHOOK_SECRET=

# --- AI features ------------------------------------------------------------

# The concierge, demo, describe and agent endpoints. Without it those degrade
# rather than fail: the storefront still sells.
ANTHROPIC_API_KEY=

# --- Email (optional) -------------------------------------------------------

# Both must be set or email stays off and every send is a logged no-op.
RESEND_API_KEY=
EMAIL_FROM=

# --- Admin ------------------------------------------------------------------

# Gate for /admin. Unset means the admin console reports "not configured"
# rather than defaulting to something guessable.
ADMIN_PASSWORD=

# --- Runtime ----------------------------------------------------------------

# Host port to publish. The container always listens on 8080 internally.
PORT=8080

# Set true only when a reverse proxy you control sits in front, so
# X-Forwarded-For and X-Forwarded-Proto can be believed. Turning this on
# without a proxy lets any client spoof its own IP past the rate limiter.
TRUST_PROXY=false

# Set false to run the container without the four cron jobs — the right setting
# for a second replica, or when running alongside the Netlify deploy so the
# crawlers do not double up.
ENABLE_SCHEDULER=true
