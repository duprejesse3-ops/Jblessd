# Local development environment variables.
#
# Copy this file to .env (already gitignored) and fill in real values to run
# any netlify/functions/*.mts file locally via `npm run fn <name>` — see
# scripts/run-function.mts. Netlify itself never reads this file; in
# production these same keys are set in the Netlify dashboard under
# Site configuration → Environment variables. Keeping both in sync is on you —
# this file is only a local dev convenience.

# --- Database (Netlify DB / Neon) -------------------------------------------
# The connection string Netlify auto-provisions and injects in production.
# To run functions locally, copy the value from Netlify's dashboard
# (Site configuration → Environment variables → NETLIFY_DATABASE_URL), or run
# `netlify env:get NETLIFY_DATABASE_URL` with the Netlify CLI if you have it
# linked to this site.
NETLIFY_DATABASE_URL=

# --- Anthropic (velocity-engine, scenario-generator, marketing-agent, etc.) -
ANTHROPIC_API_KEY=

# --- Site ---------------------------------------------------------------
SITE_URL=https://jblessd.com

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (email) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- X / Twitter (x-poster.mts) ---------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_POST_BATCH_SIZE=1

# --- Reddit (reddit-poster.mts) ---------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=indiebiz
REDDIT_USER_AGENT=jblessd-velocity-engine/1.0 by u/MultiNicheAI81
REDDIT_POST_BATCH_SIZE=1

# --- Google Ads ---------------------------------------------------------
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_LABEL=
GOOGLE_ADS_PURCHASE_LABEL=
GOOGLE_MERCHANT_RETURN_POLICY_LABEL=

# --- Scheduled batch job tuning (optional — sane defaults exist in code) ----
SCORECARD_ENABLED=true
SCORECARD_BATCH_SIZE=
MULTIADS_ENABLED=true
MULTIADS_BATCH_SIZE=
MULTIADS_STALE_DAYS=
GUIDES_ENABLED=true
GUIDES_BATCH_SIZE=
GUIDES_STALE_DAYS=
ADS_NETWORK_ENABLED=true
ADS_NETWORK_BATCH_SIZE=
ADS_NETWORK_STALE_DAYS=
